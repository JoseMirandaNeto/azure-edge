# Build-time game-server URL for the client (optional).
# Only needed when the client is hosted somewhere other than the same
# host as server-game — e.g. Netlify hosting the client while Render
# hosts server-game. `?server=` in the page URL still wins over this.
# VITE_GAME_SERVER_URL=wss://azure-edge-server-game.onrender.com
